APP_NAME="Meridian API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
PUBLIC_SITE_URL=http://localhost:3002
STUDIO_URL=http://localhost:3003
MEDIA_URL=http://localhost:8000/storage
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3002,http://127.0.0.1:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3001,localhost:3003,127.0.0.1:3001,127.0.0.1:3003

# Production example (API behind a TLS-terminating proxy):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# TRUSTED_PROXIES=*
# TRUSTED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://studio.example.com
# SANCTUM_STATEFUL_DOMAINS=www.example.com,studio.example.com
# SESSION_DOMAIN=.example.com
# SESSION_SECURE_COOKIE=true
# PUBLIC_SITE_URL=https://www.example.com
# STUDIO_URL=https://studio.example.com
# MEDIA_URL=https://api.example.com/storage
# LOG_CHANNEL=stderr

SEARCH_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
DEMO_MODE=true
MEDIA_DISK=public
MEDIA_MAX_SIZE=10485760
REVERB_APP_ID=meridian
REVERB_APP_KEY=meridian-local-key
REVERB_APP_SECRET=meridian-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
