{"data":{"type":"page","id":1,"template":"home","status":"published","is_home":true,"locale":"en","content_locale":"en","is_fallback":false,"title":"Meridian Industrial Group","slug":"home","excerpt":"An industrial technology and engineering partner connecting expertise, intelligent systems, and measurable business outcomes.","url":"/en","published_at":"2026-10-28T04:00:43+00:00","updated_at":"2026-11-27T04:00:43+00:00","featured_image":null,"blocks":[{"uid":"d0432666-e892-4229-8f51-a73a4a036291","type":"hero","props":{"eyebrow":"Bangkok · Singapore · Rayong","headline":"Engineering progress.\nEnabling possibility.","accent_line":"Industrial intelligence, delivered.","body":"We connect industrial expertise, intelligent systems, and measurable business outcomes for organisations that cannot afford to guess.","primary_cta":{"label":"Discuss a project","url":"/en/contact","style":"primary"},"secondary_cta":{"label":"Explore solutions","url":"/en/solutions","style":"secondary"},"image":{"media_id":2,"url":"http://localhost:8000/storage/media/seed/manufacturing.webp","alt":"Automotive assembly line in a modern factory"},"layout":"panel","show_scroll":true,"meta":[{"label":"Established","value":"2009"},{"label":"Specialists","value":"240+"},{"label":"Sectors","value":"05"},{"label":"Based","value":"Bangkok"}],"theme":"dark","align":"left","scroll_label":"Scroll to explore"},"responsive":{"desktop":true,"tablet":true,"mobile":true,"overrides":[]}},{"uid":"f85a008f-8ccf-49c1-bdd4-2f2f6f43b999","type":"statement","props":{"eyebrow":"Who we are","heading":"Industrial systems are only valuable when the people running them can trust what happens next.","body":"Meridian works where engineering meets real operations. Our job is to make plants, systems, and teams behave as one accountable operation, which usually means changing how they share data and decisions.","aside":"Our work runs from process diagnosis through commissioning, handover, and long-term support. The same team remains accountable across the whole path.","link_label":"Our approach","link_url":"/en/about","theme":"light"},"responsive":{"desktop":true,"tablet":true,"mobile":true,"overrides":[]}},{"uid":"5ed0b18e-b5eb-4e6b-90a7-48506c167c85","type":"capabilities","props":{"eyebrow":"Capabilities","heading":"From process audit to operating system.","intro":"Six disciplines working as one practice, from the shop floor to the executive view.","items":[{"number":"01","title":"Industrial automation","description":"Control architecture, robotics, and line integration engineered for uptime.","image":{"media_id":3,"url":"http://localhost:8000/storage/media/seed/automation.webp","alt":"Industrial robotic arm on an engineering bench"},"url":"/en/solutions"},{"number":"02","title":"Smart manufacturing","description":"Traceability, OEE, and quality intelligence built on the plant floor.","image":{"media_id":2,"url":"http://localhost:8000/storage/media/seed/manufacturing.webp","alt":"Automotive assembly line in a modern factory"},"url":"/en/solutions"},{"number":"03","title":"Industrial software","description":"Operational platforms that turn machine data into decisions.","image":{"media_id":7,"url":"http://localhost:8000/storage/media/seed/precision.webp","alt":"Five-axis CNC machining centre"},"url":"/en/solutions"},{"number":"04","title":"Infrastructure engineering","description":"Resilient electrical, utility, and facility systems for critical operations.","image":{"media_id":4,"url":"http://localhost:8000/storage/media/seed/infrastructure.webp","alt":"Container cranes above stacked shipping containers"},"url":"/en/solutions"}],"theme":"light"},"responsive":{"desktop":true,"tablet":true,"mobile":true,"overrides":[]}},{"uid":"c8fd432c-b1e6-4eb9-bc04-a83dbc4e384d","type":"services_grid","props":{"eyebrow":"Solutions","heading":"Engineering capability, organised around outcomes.","intro":"Every engagement starts with the business constraint, so the technology choice comes after the diagnosi