media/seed/variants/manufacturing-medium.webp","width":800,"height":533}]},"url":"/en/solutions/smart-manufacturing"},{"id":3,"key":"industrial-software","title":"Industrial Software","slug":"industrial-software","tagline":"Operational platforms that turn machine data into decisions.","overview":"We build focused operational software where off-the-shelf tools stop short: production portals, quality workflows, asset registers, and integration layers. Every interface is designed for the shift, not for a demo.","icon":"code","image":{"id":8,"url":"http://localhost:8000/storage/media/seed/site-plan.webp","alt":"Engineering site plan drawing","caption":"Illustrative engineering site plan.","credit":"US Army Corps of Engineers","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/site-plan-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/site-plan-medium.webp","width":800,"height":533}]},"url":"/en/solutions/industrial-software"},{"id":4,"key":"infrastructure-engineering","title":"Infrastructure Engineering","slug":"infrastructure-engineering","tagline":"Resilient electrical, utility, and facility systems for critical operations.","overview":"From load studies to commissioning, we engineer the physical systems that keep production and services running. Our work is judged by resilience, maintainability, and a handover package the client's own team can operate.","icon":"grid","image":{"id":4,"url":"http://localhost:8000/storage/media/seed/infrastructure.webp","alt":"Container cranes above stacked shipping containers","caption":null,"credit":"Guilhem Vellut","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/infrastructure-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/infrastructure-medium.webp","width":800,"height":533}]},"url":"/en/solutions/infrastructure-engineering"},{"id":5,"key":"digital-transformation","title":"Digital Transformation","slug":"digital-transformation","tagline":"A practical route from fragmented systems to a connected operation.","overview":"Transformation fails when it starts with technology. We help leadership sequence change around a clear operating problem, then deliver the data, systems, and habits that make the change durable.","icon":"nodes","image":{"id":8,"url":"http://localhost:8000/storage/media/seed/site-plan.webp","alt":"Engineering site plan drawing","caption":"Illustrative engineering site plan.","credit":"US Army Corps of Engineers","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/site-plan-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/site-plan-medium.webp","width":800,"height":533}]},"url":"/en/solutions/digital-transformation"},{"id":6,"key":"system-integration","title":"System Integration","slug":"system-integration","tagline":"One accountable team across vendors, protocols, and sites.","overview":"We take responsibility for the seams. Meridian coordinates vendors, designs the integration layer, tests the whole system, and stays accountable when something does not behave as specified.","icon":"link","image":{"id":7,"url":"http://localhost:8000/storage/media/seed/precision.webp","alt":"Five-axis CNC machining centre","caption":null,"credit":"Wikimedia Commons contributor","width":1200,"height":932,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/precision-thumb.webp","width":480,"height":373},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/precision-medium.webp","width":800,"height":621}]},"url":"/en/solutions/system-integration"}]}},{"uid":"eb016eab-c45a-