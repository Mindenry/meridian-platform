{"data":{"type":"page","id":1,"template":"home","status":"published","is_home":true,"locale":"en","content_locale":"en","is_fallback":false,"title":"Meridian Industrial Group","slug":"home","excerpt":"An industrial technology and engineering partner connecting expertise, intelligent systems, and measurable business outcomes.","url":"/en","published_at":"2026-10-27T15:13:03+00:00","updated_at":"2026-11-26T15:13:03+00:00","featured_image":null,"blocks":[{"uid":"fb5dacc4-830c-44be-842e-272a850d6e73","type":"hero","props":{"eyebrow":"Bangkok · Singapore · Rayong","headline":"Engineering progress.\nEnabling possibility.","accent_line":"Industrial intelligence, delivered.","body":"We connect industrial expertise, intelligent systems, and measurable business outcomes for organisations that cannot afford to guess.","primary_cta":{"label":"Discuss a project","url":"/en/contact","style":"primary"},"secondary_cta":{"label":"Explore solutions","url":"/en/solutions","style":"secondary"},"image":{"media_id":2,"url":"http://localhost:8000/storage/media/seed/manufacturing.webp","alt":"Automotive assembly line in a modern factory"},"layout":"panel","show_scroll":true,"meta":[{"label":"Established","value":"2009"},{"label":"Specialists","value":"240+"},{"label":"Sectors","value":"05"},{"label":"Based","value":"Bangkok"}],"theme":"dark","align":"left","scroll_label":"Scroll to explore"},"responsive":{"desktop":true,"tablet":true,"mobile":true,"overrides":[]}},{"uid":"0d47746e-6ed6-4a88-9c0e-f6caf26666ed","type":"statement","props":{"eyebrow":"Who we are","heading":"Industrial systems are only valuable when the people running them can trust what happens next.","body":"Meridian exists to work where engineering meets real operations. We do not sell technology in isolation; we help plants, systems, and teams behave as one accountable operation.","aside":"Our work runs from process diagnosis through commissioning, handover, and long-term support. The same team remains accountable across th