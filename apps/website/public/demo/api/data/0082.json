{"data":[{"id":1,"title":"The hidden cost of a dashboard nobody trusts","slug":"dashboard-nobody-trusts","excerpt":"A dashboard is not a data product until someone can trace its numbers back to a verified signal. Most operational reporting fails before the first chart is drawn.","type":"technical","reading_time":1,"published_at":"2026-11-14T15:13:03+00:00","is_featured":true,"category":{"slug":"digital","name":"Data & digital"},"author":{"name":"Siriporn Khamdee","job_title":"SEO Lead"},"image":{"id":5,"url":"http://localhost:8000/storage/media/seed/logistics.webp","alt":"High-bay warehouse racking and pallets","caption":null,"credit":"FEMA / DHS","width":1200,"height":797,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/logistics-thumb.webp","width":480,"height":319},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/logistics-medium.webp","width":800,"height":531}]},"url":"/en/insights/dashboard-nobody-trusts"},{"id":9,"title":"Meridian opens a smart manufacturing lab in Rayong","slug":"rayong-smart-manufacturing-lab","excerpt":"The demonstration lab connects a small production cell, quality inspection, and an operating data model in one testable environment.","type":"announcement","reading_time":1,"published_at":"2026-11-20T15:13:03+00:00","is_featured":false,"category":{"slug":"news","name":"Company news"},"author":{"name":"Nattaya Boonsong","job_title":"Senior Content Editor"},"image":{"id":2,"url":"http://localhost:8000/storage/media/seed/manufacturing.webp","alt":"Automotive assembly line in a modern factory","caption":null,"credit":"Marek Slusarczyk (Tupungato)","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/manufacturing-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/manufacturing-medium.webp","width":800,"height":533}]},"url":"/en/insights/rayong-smart-manufacturing-lab"},{"id":10,"title":"Meridian publishes its 2026 industrial outlook","slug":"2026-industrial-outlook","excerpt":"A demonstration report on the operating themes shaping industrial investment: energy resilience, brownfield capability, and the cost of untrusted data.","type":"report","reading_time":1,"published_at":"2026-11-11T15:13:03+00:00","is_featured":false,"category":{"slug":"reports","name":"Industry reports"},"author":{"name":"Siriporn Khamdee","job_title":"SEO Lead"},"image":{"id":6,"url":"http://localhost:8000/storage/media/seed/energy.webp","alt":"Electrical substation with transmission infrastructure","caption":null,"credit":"Saiphani02","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/energy-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/energy-medium.webp","width":800,"height":533}]},"url":"/en/insights/2026-industrial-outlook"},{"id":2,"title":"Designing for changeover, not just throughput","slug":"designing-for-changeover","excerpt":"A line optimised for one product is a line that punishes every product after it. Changeover is a design constraint, not an operator problem.","type":"insight","reading_time":1,"published_at":"2026-11-06T15:13:03+00:00","is_featured":false,"category":{"slug":"operations","name":"Manufacturing & operations"},"author":{"name":"Nattaya Boonsong","job_title":"Senior Content Editor"},"image":{"id":2,"url":"http://localhost:8000/storage/media/seed/manufacturing.webp","alt":"Automotive assembly line in a modern factory","caption":null,"credit":"Marek Slusarczyk (Tupungato)","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/manufacturing-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/manufacturing-medium.webp","width":800,"height":533}]},"url":"/en/insights/designing-for-changeover"},{"id":3,"title":"What operational data should never do","slug":"operational-data-boundaries","excerpt":"Plant data becomes risky when it is copied without context, exposed without purpose, or trusted without lineage. Three boundaries worth designing early.","type":"technical","reading_time":1,"published_at":"2026-10-29T15:13:03+00:00","is_featured":false,"category":{"slug":"digital","name":"Data & digital"},"author":{"name":"Siriporn Khamdee","job_title":"SEO Lead"},"image":{"id":3,"url":"http://localhost:8000/storage/media/seed/automation.webp","alt":"Industrial robotic arm on an engineering bench","caption":null,"credit":"Auledas","width":1200,"height":971,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/automation-thumb.webp","width":480,"height":388},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/automation-medium.webp","width":800,"height":647}]},"url":"/en/insights/operational-data-boundaries"},{"id":11,"title":"Meridian launches an automation apprenticeship","slug":"automation-apprenticeship","excerpt":"A two-year programme pairing electrical, controls, and software apprentices with working engineers on live projects.","type":"news","reading_time":1,"published_at":"2026-10-24T15:13:03+00:00","is_featured":false,"category":{"slug":"news","name":"Company news"},"author":{"name":"Nattaya Boonsong","job_title":"Senior Content Editor"},"image":{"id":7,"url":"http://localhost:8000/storage/media/seed/precision.webp","alt":"Five-axis CNC machining centre","caption":null,"credit":"Wikimedia Commons contributor","width":1200,"height":932,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/precision-thumb.webp","width":480,"height":373},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/precision-medium.webp","width":800,"height":621}]},"url":"/en/insights/automation-apprenticeship"},{"id":4,"title":"The case for brownfield automation","slug":"brownfield-automation-case","excerpt":"New lines are photogenic. Existing lines pay the bills. Most of the industrial opportunity in the region sits inside plants that cannot stop.","type":"insight","reading_time":1,"published_at":"2026-10-21T15:13:03+00:00","is_featured":false,"category":{"slug":"operations","name":"Manufacturing & operations"},"author":{"name":"Daniel Lim","job_title":"Head of Communications"},"image":{"id":7,"url":"http://localhost:8000/storage/media/seed/precision.webp","alt":"Five-axis CNC machining centre","caption":null,"credit":"Wikimedia Commons contributor","width":1200,"height":932,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/precision-thumb.webp","width":480,"height":373},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/precision-medium.webp","width":800,"height":621}]},"url":"/en/insights/brownfield-automation-case"},{"id":5,"title":"How to specify a digital twin that earns its keep","slug":"digital-twin-that-earns-its-keep","excerpt":"Most twins are models looking for a question. A useful one is bounded, maintained, and tied to a decision someone actually makes.","type":"technical","reading_time":1,"published_at":"2026-10-13T15:13:03+00:00","is_featured":false,"category":{"slug":"digital","name":"Data & digital"},"author":{"name":"Siriporn Khamdee","job_title":"SEO Lead"},"image":{"id":3,"url":"http://localhost:8000/storage/media/seed/automation.webp","alt":"Industrial robotic arm on an engineering bench","caption":null,"credit":"Auledas","width":1200,"height":971,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/automation-thumb.webp","width":480,"height":388},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/automation-medium.webp","width":800,"height":647}]},"url":"/en/insights/digital-twin-that-earns-its-keep"},{"id":6,"title":"Cybersecurity is now a plant-floor discipline","slug":"cybersecurity-plant-floor","excerpt":"The control network is no longer isolated, and the maintenance laptop is part of the attack surface. Security has to be designed with operations, not handed to IT afterwards.","type":"insight","reading_time":1,"published_at":"2026-10-05T15:13:03+00:00","is_featured":false,"category":{"slug":"resilience","name":"Infrastructure & resilience"},"author":{"name":"Daniel Lim","job_title":"Head of Communications"},"image":{"id":6,"url":"http://localhost:8000/storage/media/seed/energy.webp","alt":"Electrical substation with transmission infrastructure","caption":null,"credit":"Saiphani02","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/energy-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/energy-medium.webp","width":800,"height":533}]},"url":"/en/insights/cybersecurity-plant-floor"},{"id":7,"title":"Five questions before your first robot cell","slug":"five-questions-robot-cell","excerpt":"A robot is rarely the hard part. The hard part is the material, the fixture, the exception, and the person who has to recover the cell at 2 a.m.","type":"insight","reading_time":1,"published_at":"2026-09-26T15:13:03+00:00","is_featured":false,"category":{"slug":"operations","name":"Manufacturing & operations"},"author":{"name":"Nattaya Boonsong","job_title":"Senior Content Editor"},"image":{"id":3,"url":"http://localhost:8000/storage/media/seed/automation.webp","alt":"Industrial robotic arm on an engineering bench","caption":null,"credit":"Auledas","width":1200,"height":971,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/automation-thumb.webp","width":480,"height":388},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/automation-medium.webp","width":800,"height":647}]},"url":"/en/insights/five-questions-robot-cell"},{"id":8,"title":"Why infrastructure projects fail at the handover","slug":"handover-failure-infrastructure","excerpt":"The asset is built, the ribbon is cut, and the operating team inherits a system nobody designed for them. Handover is a design phase, not a final meeting.","type":"insight","reading_time":1,"published_at":"2026-09-15T15:13:03+00:00","is_featured":false,"category":{"slug":"resilience","name":"Infrastructure & resilience"},"author":{"name":"Daniel Lim","job_title":"Head of Communications"},"image":{"id":4,"url":"http://localhost:8000/storage/media/seed/infrastructure.webp","alt":"Container cranes above stacked shipping containers","caption":null,"credit":"Guilhem Vellut","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storage/media/seed/variants/infrastructure-thumb.webp","width":480,"height":320},{"name":"medium","url":"http://localhost:8000/storage/media/seed/variants/infrastructure-medium.webp","width":800,"height":533}]},"url":"/en/insights/handover-failure-infrastructure"},{"id":12,"title":"Meridian appoints a Director of Digital Systems","slug":"director-digital-systems","excerpt":"The role brings industrial software, integration, and data practice under one accountable leader.","type":"announcement","reading_time":1,"published_at":"2026-09-07T15:13:03+00:00","is_featured":false,"category":{"slug":"news","name":"Company news"},"author":{"name":"Nattaya Boonsong","job_title":"Senior Content Editor"},"image":{"id":1,"url":"http://localhost:8000/storage/media/seed/hero-facility.webp","alt":"Container ship and gantry cranes at a commercial port","caption":null,"credit":"Niels Johannes","width":1200,"height":800,"focal_x":0.5,"focal_y":0.5,"variants":[{"name":"thumb","url":"http://localhost:8000/storag