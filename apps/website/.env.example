# Browser-facing API (must be reachable from the visitor's machine).
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# Server-side API (SSR, sitemaps, document proxy). In Compose this is the
# internal service URL, for example http://nginx:80/api/v1. On Netlify it must
# be the public HTTPS API origin because functions cannot reach your private
# network.
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000/api/v1

NUXT_PUBLIC_SITE=meridian
NUXT_PUBLIC_SITE_URL=http://localhost:3002
NUXT_PUBLIC_STUDIO_URL=http://localhost:3003
NUXT_PUBLIC_DEMO_MODE=true

# Static portfolio demo: build from committed fixtures and send no API calls.
# NUXT_PUBLIC_DEMO_STATIC=true
# NUXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Netlify production example:
# NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
# NUXT_API_INTERNAL_BASE=https://api.example.com/api/v1
# NUXT_PUBLIC_SITE_URL=https://www.example.com
# NUXT_PUBLIC_STUDIO_URL=https://studio.example.com
# NUXT_PUBLIC_DEMO_MODE=true
# NITRO_PRESET=netlify
