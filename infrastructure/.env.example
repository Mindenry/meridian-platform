# Copy to infrastructure/.env and change every value before exposing this stack.
#
# The defaults are deliberately non-secret demo values. They are committed so
# `docker compose up` works out of the box for local review, not for production.

# Laravel application key. Rotate with:
#   docker compose run --rm api php artisan key:generate --show
APP_KEY=base64:Tom/CUI3Bw+E8/a2VmaInjgFMTk0+hoVboUHtCouxzU=

# PostgreSQL
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=meridian-local

# Meilisearch
MEILI_MASTER_KEY=meridian-local-meili-key

# MinIO (also used as the S3 access key inside the stack)
MINIO_ROOT_USER=meridian
MINIO_ROOT_PASSWORD=meridian-local-secret

# Seed the illustrative demo content once on first boot.
SEED_DEMO=true

# Production example. Set these in infrastructure/.env and run
# ./infrastructure/prod-up.sh. Use custom domains; do not mix Netlify default
# hosts with an API on another registrable domain (cookies will be blocked).
# APP_URL=https://api.example.com
# PUBLIC_SITE_URL=https://www.example.com
# STUDIO_URL=https://studio.example.com
# MEDIA_URL=https://api.example.com/storage
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://studio.example.com
# SANCTUM_STATEFUL_DOMAINS=www.example.com,studio.example.com
# SESSION_DOMAIN=.example.com
# SESSION_SECURE_COOKIE=true
# DEMO_MODE=false
# SEED_DEMO=false

# Broadcast driver. Use `reverb` together with `--profile realtime`.
BROADCAST_CONNECTION=log
